[flake8]
max-line-length = 120
# E402: module level import not at top of file
# Suppressed globally because all src/ modules intentionally call
# sys.path.insert() before importing from src.* to support both
# 'python -m src.foo' and standalone 'python src/foo.py' execution.
extend-ignore = E402
exclude =
    .venv,
    venv,
    env,
    __pycache__,
    .git,
    build,
    dist,
    *.egg-info,
    data/,
    logs/,
    docs/,
    notebooks/
